rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'xzdsf286@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['profit_margin', 'provider_url']) &&
             data.profit_margin is number &&
             data.provider_url is string &&
             data.provider_url.size() <= 500;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && userId == request.auth.uid;
      allow update: if (isOwner(userId) || isAdmin()) && 
                    (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
    }

    // Services (Read for all, write for admin)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false; // Only via server
      allow update: if isAdmin();
    }

    // Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings(request.resource.data);
    }

    // Config
    match /config/global {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Deposits (Manual)
    match /deposits/{depositId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Package Orders
    match /package_orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Web Orders
    match /web_orders/{orderId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
    }
  }
}
